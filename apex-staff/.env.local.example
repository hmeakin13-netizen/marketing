# Supabase project settings for the TEAM portal project — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (never NEXT_PUBLIC_). Used only by the admin-gated Add/Deactivate person
# actions to create or lock a staff login.
SUPABASE_SERVICE_ROLE_KEY=

# Invoices (optional until you want emails)
CRON_SECRET=
RESEND_API_KEY=
EMAIL_FROM="Apex Leads <invoices@apex-leads.co.uk>"
INVOICE_TO=info@apex-leads.co.uk
COMPANY_NAME="Apex Leads"
COMPANY_ADDRESS=
COMPANY_VAT=
